# Server
PORT=4000
NODE_ENV=development
# Allowed frontend origin(s), comma separated (your Vercel URL in production)
CLIENT_URL=http://localhost:3000
# MongoDB Atlas connection string
MONGODB_URI=
# Long random string, for example: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional: only this email may become the first admin on registration
ADMIN_EMAIL=
# Cloudinary (chat attachments). Uploads are disabled when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Seed script only
SEED_ADMIN_EMAIL=
SEED_PASSWORD=
# Exchange sync: 64 hex characters (openssl rand -hex 32). Encrypts stored API keys.
# Keep a backup: if it is lost, saved connections must be re-entered.
ENCRYPTION_KEY=
# Minutes between automatic syncs (0 disables the background sync)
SYNC_INTERVAL_MIN=5
